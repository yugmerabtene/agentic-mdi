# Modèle de configuration — agent autonome de micro-projets.
# Ce fichier est versionné : il ne doit contenir que des gabarits.
# Pour utiliser le projet, le copier vers un fichier « .env » local, puis
# remplacer chaque gabarit par la valeur réelle. Le fichier « .env » est
# écarté par Git et ne doit jamais être versionné ni transmis.

# Clé d'interface Groq : console.groq.com, rubrique des clés d'API.
# Portée limitée au modèle choisi, elle suffit aux requêtes de l'agent.
GROQ_API_KEY=<VOTRE_CLE_API_GROQ>

# Jeton d'accès GitHub : paramètres du compte, rubrique « Developer
# settings », puis « Personal access tokens ». La portée « repo » est
# indispensable, l'agent crée et publie les dépôts avec ce jeton.
GITHUB_TOKEN=<VOTRE_TOKEN_GITHUB>

# Intervalle entre deux cycles de l'agent, exprimé en secondes.
CYCLE_INTERVAL=300