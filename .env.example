# Variables d'environnement du laboratoire de gestion des utilisateurs.
#
# Usage : copiez ce fichier en .env, puis remplacez chaque gabarit entre
# chevrons par une valeur de laboratoire de votre choix.
#
#   cp .env.example .env
#
# Le fichier .env n'est jamais versionné : il est inscrit au .gitignore. Seul
# ce gabarit l'est. Ne versionnez jamais la copie.

# --- Base de données : ce que l'application utilise ------------------------
# Valeurs non sensibles : elles définissent où se trouve la base.
DB_NAME=gestion_users
DB_PUBLISHED_PORT=3307
APP_PORT=8080

# --- Base de données : secrets à vous de les fixer --------------------------
# Un mot de passe de laboratoire doit vérifier la règle du cahier des charges :
# huit caractères au moins, une majuscule, une minuscule, un chiffre. Faites-le
# différent pour chaque variable, et différent de tout mot de passe utilisé
# ailleurs.
MYSQL_USER=<A_COMPLETER>
MYSQL_PASSWORD=<MOT_DE_PASSE_A_COMPLETER>
MYSQL_ROOT_PASSWORD=<MOT_DE_PASSE_ROOT_A_COMPLETER>
