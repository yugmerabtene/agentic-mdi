{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrateur",
  "model": "opencode/big-pickle",
  "small_model": "opencode/big-pickle",
  "logLevel": "WARN",
  "share": "disabled",
  "subagent_depth": 1,
  "instructions": ["AGENTS.md", "CONTEXT.md"],
  "skills": { "paths": [".opencode/skills"] },
  "tool_output": { "max_bytes": 6000, "max_lines": 80 },
  "compaction": {
    "auto": true,
    "prune": true,
    "preserve_recent_tokens": 6000,
    "reserved": 6000,
    "tail_turns": 6
  },
  "experimental": { "batch_tool": true },
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "general": { "disable": true },
    "explore": { "disable": true },
    "orchestrateur": {
      "permission": {
        "edit": {
          "*": "deny",
          "CONTEXT.md": "allow",
          "suivi.json": "allow",
          "CDC/**": "allow"
        },
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git status *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "git add": "allow",
          "git add *": "allow",
          "git commit": "allow",
          "git commit *": "allow",
          "git push": "allow",
          "git push *": "allow",
          "git pull": "allow",
          "git pull *": "allow",
          "./check-secrets.sh": "allow",
          "ls": "allow",
          "ls *": "allow",
          "rtk ls *": "allow",
          "cat": "allow",
          "cat *": "allow",
          "wc": "allow",
          "wc *": "allow",
          "jq": "allow",
          "jq *": "allow",
          "date -u": "allow",
          "date -u *": "allow",
          "mkdir *": "allow",
          "touch *": "allow",
          "cp *": "allow",
          "mv *": "allow",
          "tee *": "allow",
          "rm *": "allow",
          "git push --force*": "deny",
          "git push -f*": "deny",
          "git reset --hard*": "deny",
          "git rebase*": "deny",
          "git filter-branch*": "deny",
          "git clean -fd": "deny",
          "git clean -fd *": "deny",
          "git clean -fd*": "deny",
          "git checkout .": "deny",
          "git checkout -- .": "deny",
          "git commit --amend*": "deny",
          "git commit -a --amend*": "deny",
          "rm -rf*": "deny",
          "rm -fr*": "deny",
          "sudo *": "deny",
          "su *": "deny",
          "chmod 777*": "deny"
        },
        "skill": {
          "*": "deny",
          "common": "allow",
          "cadrage": "allow",
          "tests": "allow",
          "suivi": "allow"
        },
        "task": {
          "*": "deny",
          "developpeur": "allow",
          "code-reviewer": "allow",
          "devops": "allow"
        },
        "question": "deny"
      }
    },
    "developpeur": {
      "permission": {
        "edit": "allow",
        "task": "deny",
        "question": "deny",
        "bash": {
          "*": "allow",
          "git push --force*": "deny",
          "git push -f*": "deny",
          "git reset --hard*": "deny",
          "git clean -fd": "deny",
          "git clean -fd *": "deny",
          "git checkout .": "deny",
          "git checkout -- .": "deny",
          "git rebase*": "deny",
          "git filter-branch*": "deny",
          "git commit --amend*": "deny",
          "git commit -a --amend*": "deny",
          "rm -rf*": "deny",
          "rm -fr*": "deny",
          "sudo *": "deny",
          "su *": "deny",
          "chmod 777*": "deny"
        },
        "skill": {
          "*": "deny",
          "common": "allow",
          "developpement": "allow",
          "tests": "allow",
          "suivi": "allow"
        }
      }
    },
    "code-reviewer": {
      "permission": {
        "edit": { "*": "deny", "suivi.json": "allow" },
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git status *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "ls": "allow",
          "ls *": "allow",
          "rtk ls *": "allow",
          "cat": "allow",
          "cat *": "allow",
          "wc": "allow",
          "wc *": "allow"
        },
        "skill": {
          "*": "deny",
          "common": "allow",
          "revue": "allow",
          "tests": "allow",
          "suivi": "allow"
        },
        "task": "deny",
        "question": "deny",
        "todowrite": "deny"
      }
    },
    "devops": {
      "permission": {
        "edit": "allow",
        "task": "deny",
        "question": "deny",
        "bash": {
          "*": "allow"
        },
        "skill": {
          "*": "deny",
          "common": "allow",
          "ops": "allow",
          "tests": "allow",
          "suivi": "allow"
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "id_rsa*": "deny",
      "id_ed25519*": "deny",
      ".netrc": "deny",
      ".npmrc": "deny",
      ".pypirc": "deny",
      "credentials*": "deny",
      "secrets*": "deny"
    },
    "edit": {
      "*": "deny",
      "CONTEXT.md": "allow",
      "suivi.json": "allow",
      "CDC/**": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "doom_loop": "allow",
    "skill": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "question": "allow",
    "external_directory": "allow",
    "task": {
      "*": "deny",
      "developpeur": "allow",
      "code-reviewer": "allow",
      "devops": "allow"
    },
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd": "deny",
      "git clean -fd *": "deny",
      "git checkout .": "deny",
      "git checkout -- .": "deny",
      "git rebase*": "deny",
      "git filter-branch*": "deny",
      "git commit --amend*": "deny",
      "git commit -a --amend*": "deny",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "chmod 777*": "deny"
    }
  }
}
